PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (Supabase PostgreSQL URL or local fallback)
DATABASE_URL=sqlite:./safehome.sqlite

# Supabase Credentials (Optional for cloud DB/auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Unified Python Microservice
PYTHON_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SECRET=your_ai_service_secret_key_here

# Network & Authentication
CORS_ORIGIN=*
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Payment Gateway (Keep real secrets safe in .env, never commit!)
# Get your Key ID and Key Secret from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
# RAZORPAY_WEBHOOK_SECRET is optional (only needed if using Razorpay Webhooks)
RAZORPAY_WEBHOOK_SECRET=
