# ─────────────────────────────────────────────────────────────────────────────
# SafeHome AI - Environment Configuration
# Copy this file to backend/.env and fill in your values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL DEV  → uses SQLite (no setup needed)
DATABASE_URL=sqlite:./safehome.sqlite

# PRODUCTION → must be a PostgreSQL connection string (Render / Supabase / Neon)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# PostgreSQL pool settings (only used when DATABASE_URL is postgres://)
DB_POOL_MAX=10
DB_SSL=true

# ── Supabase (Optional — only if using Supabase for auth/realtime) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Python AI Microservice ────────────────────────────────────────────────────
PYTHON_SERVICE_URL=http://127.0.0.1:8000
# Must match AI_SERVICE_SECRET set in the python-service environment
AI_SERVICE_SECRET=your_ai_service_secret_key_here_change_in_production

# ── Network & Authentication ─────────────────────────────────────────────────
# CORS_ORIGIN: Set to your frontend URL in production (e.g. https://safehome-frontend.onrender.com)
CORS_ORIGIN=*
# JWT_SECRET: Generate a long random string (min 32 chars) for production
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get your credentials from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for testing, rzp_live_... for production
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
# RAZORPAY_WEBHOOK_SECRET: Only needed if using Razorpay Webhooks
RAZORPAY_WEBHOOK_SECRET=
